<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Smallest necessary permissions for Phase 1 dialer recording compatibility spike -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Storage permissions for MediaStore discovery (version-specific) -->
    <!-- Android 13+ (API 33+) targeted audio permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 12 and below (API 32 and below) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Notifications for background test events (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase 4: Optional direct calling permission (with ACTION_DIAL fallback) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Phase 4: Optional overlay permission for caller pop-up windows -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    <!-- Phase 12: Boot completed permission for WorkManager and BootCompletedReceiver -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Declare telephony hardware feature as optional so app installs on ChromeOS / non-telephony devices -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- STRICT PRIVACY: Strictly NO contacts, SMS, location, or microphone permissions -->

    <application
        android:name=".Leads365App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Leads365">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Leads365"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Broadcast receiver for telephony state changes as fallback observation -->
        <receiver
            android:name=".calls.CallStateReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Phase 12: Reschedule background tasks and recover pending uploads on device boot -->
        <receiver
            android:name=".work.BootCompletedReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Phase 10: Firebase Cloud Messaging service for push notifications -->
        <service
            android:name=".notifications.LeadsFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
